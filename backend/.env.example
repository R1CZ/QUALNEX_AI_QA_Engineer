# Backend Environment Variables
# Copy this file to backend/.env and fill in your values

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://qualnex:qualnex@localhost:5432/qualnex
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=qualnex:jobs

# ============ OAuth - Google ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ============ OAuth - GitHub ============
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ============ Firebase Authentication ============
# Get from Firebase Console > Project Settings > General > Your Apps > Web App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Path to service account JSON file (for backend token verification)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# ============ GitHub App ============
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ============ AI - Qwen ============
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-max

# ============ Security ============
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=change-me-generate-with-fernet

# ============ Docker / Sandbox ============
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_IMAGE=qualnex/sandbox:latest
SANDBOX_NETWORK=qualnex-sandbox
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT=600
SANDBOX_MAX_CONCURRENT=10

# ============ Object Storage (S3-compatible) ============
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=qualnex
S3_SECRET_KEY=qualnex123
S3_BUCKET=qualnex-artifacts
S3_REGION=us-east-1

# ============ Application ============
APP_NAME=QUALNEX
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============ CORS ============
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
